---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Footer from '../components/Footer.astro'
import { SITE_AUTHOR, SITE_IMAGE } from '../consts'
import { getLocaleFromPath, type Locale } from '../i18n'
import { pageContentTransition, viewTransitionNameFromPath } from '../utils/viewTransitionName'

interface Props {
	frontmatter: Record<string, any>
	locale?: Locale
	alternateUrls?: Partial<Record<Locale, string>>
	enHref?: string
	frHref?: string
}

const {
	frontmatter,
	locale = getLocaleFromPath(Astro.url.pathname),
	alternateUrls: suppliedAlternateUrls,
	enHref: suppliedEnHref,
	frHref: suppliedFrHref,
} = Astro.props as Props
const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, minutesRead } =
	frontmatter
const titleTransitionName = viewTransitionNameFromPath(Astro.url.pathname)
const toIsoDate = (date: string | Date | undefined) =>
	date ? new Date(date).toISOString() : undefined
const publishedTime = toIsoDate(pubDate)
const modifiedTime = toIsoDate(updatedDate ?? pubDate)
const isNotFound = Astro.url.pathname.startsWith('/404')
const isArticle = Boolean(pubDate) && !isNotFound
const isWriting =
	Astro.url.pathname.startsWith('/write/') || Astro.url.pathname.startsWith('/fr/write/')
const articleMinutesRead = isArticle && isWriting ? minutesRead : undefined
const articleSlug = isWriting ? Astro.url.pathname.split('/').filter(Boolean).at(-1) : undefined
const socialImage = articleSlug
	? `${locale === 'fr' ? '/fr' : ''}/og/${articleSlug}.png`
	: heroImage
const isAbout = Astro.url.pathname === '/about' || Astro.url.pathname === '/fr/about'
const enHref =
	suppliedEnHref ??
	(isAbout ? '/about' : locale === 'en' && !isNotFound ? Astro.url.pathname : '/')
const frHref = suppliedFrHref ?? (isAbout ? '/fr/about' : locale === 'fr' ? Astro.url.pathname : '/fr/')
const alternateUrls =
	suppliedAlternateUrls ?? (isAbout ? { en: '/about', fr: '/fr/about' } : undefined)
const jsonLd = isNotFound
	? undefined
	: isArticle
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				url: Astro.url.pathname,
				image: socialImage ?? SITE_IMAGE,
				datePublished: publishedTime,
				dateModified: modifiedTime,
				inLanguage: locale,
				author: {
					'@type': 'Person',
					name: SITE_AUTHOR,
					url: locale === 'fr' ? '/fr/about' : '/about',
				},
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebPage',
				name: title,
				description,
				url: Astro.url.pathname,
				inLanguage: locale,
			}
---

<html lang={locale}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={socialImage}
			imageAlt={heroImageAlt ?? (articleSlug ? `${title} article card` : undefined)}
			imageWidth={articleSlug ? 1200 : undefined}
			imageHeight={articleSlug ? 630 : undefined}
			type={isArticle ? 'article' : 'website'}
			publishedTime={isArticle ? publishedTime : undefined}
			modifiedTime={isArticle ? modifiedTime : undefined}
			jsonLd={jsonLd}
			{locale}
			{alternateUrls}
		/>
	</head>

	<body>
		<Header {locale} {enHref} {frHref} />

		<main
			class="content stack"
			transition:name="page-content"
			transition:animate={pageContentTransition}
		>
			<article class="stack">
				{
					heroImage && (
						<p class="stack">
							<img width="1020" height="510" src={heroImage} alt="" />
						</p>
					)
				}

				<header class="stack">
					<h1
						class="transition-title"
						style={`--view-transition-name: ${titleTransitionName};`}
						transition:name={titleTransitionName}
					>
						{title}
					</h1>

					{
						(pubDate || updatedDate || articleMinutesRead) && (
							<p class="meta">
								{pubDate && (
									<span>
										<FormattedDate date={pubDate} {locale} />
									</span>
								)}
								{pubDate && (updatedDate || articleMinutesRead) ? <span> | </span> : null}
								{updatedDate && (
									<span>
										{locale === 'fr' ? 'dernière mise à jour le' : 'last updated on'}{' '}
										<FormattedDate date={updatedDate} {locale} />
									</span>
								)}
								{updatedDate && articleMinutesRead ? <span> | </span> : null}
								{articleMinutesRead && (
									<span>
										{articleMinutesRead} {locale === 'fr' ? 'min de lecture' : 'min read'}
									</span>
								)}
							</p>
						)
					}
				</header>

				<section class="stack">
					<slot />
				</section>

				{
					locale === 'fr' && isWriting && enHref !== '/' && (
						<footer class="article-original-link">
							<p>
								<a href={enHref} lang="en" hreflang="en">
									Lire la version originale en anglais
								</a>
							</p>
						</footer>
					)
				}
			</article>
		</main>

		<Footer {locale} />
	</body>
</html>

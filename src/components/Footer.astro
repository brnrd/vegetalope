---
import { Image } from 'astro:assets';
import logoImage from '../assets/vegetalope.webp';
import ThemeToggle from './ThemeToggle.astro';
import { getLocaleFromPath, getLocalePath, ui, type Locale } from '../i18n';

const pathname = Astro.url.pathname;
interface Props {
	locale?: Locale;
}
const locale = Astro.props.locale ?? getLocaleFromPath(pathname);
const strings = ui[locale];
const showRss = pathname === '/' || pathname === '/fr/' || pathname.startsWith('/write') || pathname.startsWith('/fr/write');
---

<footer class="site-footer">
	<div class="inner home-footer">
		<a class="hello" href={getLocalePath(locale, '/about')} aria-label={strings.aboutBernard}>
			<div class="top">
				<div>{strings.hello}</div>
				<p>{strings.myNameIs}</p>
			</div>
			<div class="name">
				<Image
					src={logoImage}
					formats={['webp', 'avif']}
					widths={[100, 200, 400, 800]}
					alt="vegetalope written with a black Sharpie on white paper"
					loading="lazy"
				/>
			</div>
		</a>

		<div class="footer-toggle">
			<ThemeToggle {locale} />
			{showRss && (
				<a class="footer-rss" href={locale === 'fr' ? '/fr/rss.xml' : '/rss.xml'}>RSS</a>
			)}
		</div>
	</div>
</footer>

---
interface Props {
	date: Date;
	locale?: 'en' | 'fr';
}

const { date, locale = 'en' } = Astro.props;
const dateObject = new Date(date);
---

<time datetime={dateObject.toISOString()}>
	{
		dateObject.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-GB', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	}
</time>

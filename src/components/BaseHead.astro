---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css'
import { MetaTags, type Metadata } from '@jorgejhms/astro-seo-meta-tags'
import { getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import headerLogo from '../assets/vegetalope-transparent.webp'
import {
	SITE_AUTHOR,
	SITE_DESCRIPTION,
	SITE_IMAGE,
	SITE_IMAGE_ALT,
	SITE_LOCALE,
	SITE_TITLE,
	X_HANDLE,
} from '../consts'
import { getLocaleFromPath, ui, type Locale } from '../i18n'

interface Props {
	title: string
	description?: string
	image?: Metadata['featuredImage']
	imageAlt?: string
	imageWidth?: number
	imageHeight?: number
	type?: string
	publishedTime?: string
	modifiedTime?: string
	jsonLd?: Metadata['jsonLd']
	locale?: Locale
	alternateUrls?: Partial<Record<Locale, string>>
	enableLocaleDetection?: boolean
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = SITE_IMAGE,
	imageAlt = image === SITE_IMAGE ? SITE_IMAGE_ALT : title,
	imageWidth,
	imageHeight,
	type = 'website',
	publishedTime,
	modifiedTime,
	jsonLd,
	locale = getLocaleFromPath(Astro.url.pathname),
	alternateUrls,
	enableLocaleDetection = false,
} = Astro.props
const pathname = Astro.url.pathname
const absoluteAlternateUrls = alternateUrls
	? Object.fromEntries(
			Object.entries(alternateUrls).map(([language, href]) => [
				language,
				new URL(href, Astro.site ?? Astro.url).href,
			]),
		) as Partial<Record<Locale, string>>
	: undefined
const allowIndex =
	pathname === '/' ||
	pathname === '/fr/' ||
	pathname.startsWith('/write') ||
	pathname.startsWith('/fr/write')
const usesDefaultImage = image === SITE_IMAGE
const ogProperties: Record<string, string> = {
	locale: locale === 'fr' ? 'fr_FR' : SITE_LOCALE,
	site_name: SITE_TITLE,
}

if (alternateUrls?.en && alternateUrls?.fr) {
	ogProperties.alternate_locale = locale === 'fr' ? SITE_LOCALE : 'fr_FR'
}

if (publishedTime) ogProperties.published_time = publishedTime
if (modifiedTime) ogProperties.modified_time = modifiedTime

const headerLogoImage = await getImage({
	src: headerLogo,
	widths: [140, 200, 280, 360],
	formats: ['webp'],
})
const twitterImage = image
	? new URL(typeof image === 'string' ? image : image.src, Astro.site ?? Astro.url).href
	: undefined
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<ClientRouter fallback="animate" />

<!-- Favicon -->
<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png?v=1" />

<!-- SEO, Open Graph, X card, canonical URL, and structured data -->
<MetaTags
	metadata={{
		title,
		titleTemplate: title === SITE_TITLE ? undefined : `%s | ${SITE_TITLE}`,
		description,
		author: SITE_AUTHOR,
		featuredImage: image,
		ogImageWidth: imageWidth ?? (usesDefaultImage ? 814 : undefined),
		ogImageHeight: imageHeight ?? (usesDefaultImage ? 400 : undefined),
		ogImageAlt: imageAlt,
		type,
		twitter: {
			card: 'summary_large_image',
			site: X_HANDLE,
			creator: X_HANDLE,
			image: twitterImage,
			imageAlt,
		},
		ogProperties,
		jsonLd,
		noindex: !allowIndex,
	}}
/>
{absoluteAlternateUrls?.en && <link rel="alternate" hreflang="en" href={absoluteAlternateUrls.en} />}
{absoluteAlternateUrls?.fr && <link rel="alternate" hreflang="fr" href={absoluteAlternateUrls.fr} />}
{absoluteAlternateUrls?.en && <link rel="alternate" hreflang="x-default" href={absoluteAlternateUrls.en} />}
<link
	rel="alternate"
	type="application/rss+xml"
	title={ui[locale].feedTitle}
	href={locale === 'fr' ? '/fr/rss.xml' : '/rss.xml'}
/>
<link
	rel="preload"
	as="image"
	href={headerLogoImage.src}
	imagesrcset={headerLogoImage.srcset}
	imagesizes="(max-width: 720px) 140px, 200px"
/>
<!-- Tracking -->
<script
	defer
	src="https://umami.vegetalope.com/script.js"
	data-website-id="75cd0945-8e28-45e1-8a52-006373da5261"></script>

{
	enableLocaleDetection && (
		<script is:inline>
			if (typeof window !== 'undefined' && window.location.pathname === '/') {
				let storedLocale = null;
				try {
					storedLocale = localStorage.getItem('site-locale');
				} catch {
					// Browser-language detection still works when storage is unavailable.
				}
				const browserLanguages = navigator.languages?.length
					? navigator.languages
					: [navigator.language];
				const prefersFrench = browserLanguages[0]?.toLowerCase().startsWith('fr');

				if (storedLocale === 'fr' || (!storedLocale && prefersFrench)) {
					window.location.replace('/fr/');
				}
			}
		</script>
	)
}

<!-- This is intentionally inlined to avoid FOUC -->
<script is:inline data-astro-rerun>
	if (
		typeof document !== 'undefined' &&
		typeof localStorage !== 'undefined' &&
		typeof window !== 'undefined'
	) {
		const root = document.documentElement
		const theme = localStorage.getItem('theme')
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
		if (theme === 'dark' || ((theme === 'auto' || !theme) && prefersDark)) {
			root.classList.add('theme-dark')
		} else {
			root.classList.remove('theme-dark')
		}
	}
</script>

---
import { ui } from '../i18n'

const { locale, enHref = '/', frHref = '/fr/' } = Astro.props
const strings = ui[locale]
---

<div class="language-switcher" aria-label={strings.languageSelection}>
	<a href={enHref} lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
	<span aria-hidden="true">/</span>
	<a href={frHref} lang="fr" hreflang="fr" aria-current={locale === 'fr' ? 'page' : undefined}>FR</a>
</div>

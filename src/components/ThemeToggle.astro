---
import { getLocaleFromPath, ui, type Locale } from '../i18n'

interface Props {
	locale?: Locale
}

const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname)
const strings = ui[locale]
const themes = ['auto', 'light', 'dark'] as const
---

<fieldset class="theme-toggle" data-theme-toggle>
	<legend class="sr-only">{strings.colourTheme}</legend>

	{
		themes.map(t => (
			<label>
				<input
					type="radio"
					name="theme"
					value={t}
					aria-label={strings.useTheme(strings.themes[t])}
				/>
				<span aria-hidden="true">
					<span class="btn-text">{strings.themes[t]}</span>
				</span>
			</label>
		))
	}
</fieldset>

<script is:inline data-astro-rerun>
	;(() => {
		if (typeof document === 'undefined') return

		window.__vegetalopeThemeAbort?.abort()
		window.__vegetalopeThemeAbort = new AbortController()
		const { signal } = window.__vegetalopeThemeAbort

		const root = document.documentElement
		const container = document.querySelector('[data-theme-toggle]')
		if (!container) return

		const inputs = Array.from(container.querySelectorAll('input[name="theme"]'))
		if (!inputs.length) return

		const media = window.matchMedia('(prefers-color-scheme: dark)')

		const getStoredTheme = () => {
			let stored
			try {
				stored = localStorage.getItem('theme')
			} catch {
				return 'auto'
			}
			if (stored === 'light' || stored === 'dark' || stored === 'auto') return stored
			return 'auto'
		}

		let currentTheme = getStoredTheme()

		const applyTheme = theme => {
			currentTheme = theme
			const isDark = theme === 'dark' || (theme === 'auto' && media.matches)
			root.classList.toggle('theme-dark', isDark)
			try {
				localStorage.setItem('theme', theme)
			} catch {
				/* Theme still works for this page. */
			}
			for (const input of inputs) {
				input.checked = input.value === theme
			}
		}

		applyTheme(currentTheme)

		for (const input of inputs) {
			input.addEventListener('change', () => applyTheme(input.value), { signal })
		}

		media.addEventListener(
			'change',
			() => {
				if (currentTheme === 'auto') {
					applyTheme('auto')
				}
			},
			{ signal },
		)
	})()
</script>

<style>
	fieldset {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.15rem;
		padding: 0.2rem;
		margin: 0;
		border: 1px solid var(--hairline);
		border-radius: 999px;
	}
	label {
		position: relative;
		cursor: pointer;
	}
	input {
		position: absolute;
		opacity: 0;
		margin: 0;
	}
	label > span {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0.5rem 0.85rem;
		border-radius: 999px;
		color: var(--color-ink-muted);
		transition:
			background-color 120ms ease,
			color 120ms ease;
	}
	label:hover > span {
		color: var(--color-ink);
		background: color-mix(in oklab, var(--color-ink) 5%, transparent);
	}
	input:checked + span {
		color: var(--color-bg);
		background: var(--color-ink);
	}
	input:focus-visible + span {
		outline: var(--focus);
		outline-offset: var(--focus-offset);
	}
	.btn-text {
		font-family: var(--font-label);
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>

---
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts'
import { getLocaleFromPath, getLocalePath, ui, type Locale } from '../i18n'
import logoImage from '../assets/vegetalope-transparent.avif'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
	locale?: Locale
	enHref?: string
	frHref?: string
}

const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname)
const strings = ui[locale]
const enHref =
	Astro.props.enHref ??
	(locale === 'en' && !Astro.url.pathname.startsWith('/404') ? Astro.url.pathname : '/')
const frHref = Astro.props.frHref ?? (locale === 'fr' ? Astro.url.pathname : '/fr/')
---

<a class="skip-link" href="#main-content">{locale === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
<header class="site-header">
	<div class="inner">
		<h2>
			<a class="site-logo" href={getLocalePath(locale)} aria-label={SITE_TITLE}>
				<Image
					src={logoImage}
					alt={SITE_TITLE}
					class="site-logo-mark"
					formats={['webp', 'avif']}
					widths={[140, 200, 280, 360]}
					loading="eager"
					decoding="async"
					fetchpriority="high"
					sizes="(max-width: 700px) 140px, (max-width: 1000px) 20vw, 200px"
				/>
				<span class="sr-only">{SITE_TITLE}</span>
			</a>
		</h2>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
			<span class="sr-only">{strings.toggleNavigation}</span>
			<span class="menu-lines" aria-hidden="true"></span>
		</button>

		<nav id="site-nav" class="site-nav" aria-label={strings.siteNavigation}>
			<a href={getLocalePath(locale, '/about')} aria-current={Astro.url.pathname.replace(/\/$/, '') === getLocalePath(locale, '/about') ? 'page' : undefined}>{strings.about}</a>
			<a href="https://www.linkedin.com/in/bernarddebecker/" target="_blank" rel="noreferrer">LinkedIn</a>
			<a href="https://github.com/brnrd" target="_blank" rel="noreferrer">GitHub</a>
			<LanguageSwitcher {locale} {enHref} {frHref} />
		</nav>
	</div>
</header>

<script is:inline data-astro-rerun>
	(() => {
		window.__vegetalopeHeaderAbort?.abort();
		window.__vegetalopeHeaderAbort = new AbortController();
		const { signal } = window.__vegetalopeHeaderAbort;
		const header = document.querySelector('.site-header');
		const button = header?.querySelector('.menu-toggle');
		const nav = header?.querySelector('#site-nav');
		if (!header || !button || !nav) return;
		header.classList.add('menu-ready');
		const closeMenu = () => {
			header.classList.remove('menu-open');
			button.setAttribute('aria-expanded', 'false');
		};
		button.addEventListener('click', () => {
			const isOpen = header.classList.toggle('menu-open');
			button.setAttribute('aria-expanded', String(isOpen));
		}, { signal });
		nav.addEventListener('click', (event) => {
			if (event.target.closest('a')) closeMenu();
		}, { signal });
		header.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && header.classList.contains('menu-open')) {
				closeMenu();
				button.focus();
			}
		}, { signal });
		document.addEventListener('click', (event) => {
			if (!header.contains(event.target)) closeMenu();
		}, { signal });
		header.addEventListener('focusout', (event) => {
			if (!header.contains(event.relatedTarget)) closeMenu();
		}, { signal });
		window.matchMedia('(max-width: 720px)').addEventListener('change', closeMenu, { signal });
	})();
</script>

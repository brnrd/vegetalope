---
import { getCollection } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE_TITLE, SITE_DESCRIPTION, SITE_IMAGE } from '../consts'
import { getArticleParts, ui } from '../i18n'
import { pageContentTransition, viewTransitionNameFromPath } from '../utils/viewTransitionName'

const locale = 'en' as const
const strings = ui[locale]
const writeArticles = (await getCollection('write'))
	.filter((entry) => getArticleParts(entry.id).locale === locale)
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
const latestWriteArticles = writeArticles.slice(0, 5)
---

<!DOCTYPE html>
<html lang={locale}>
	<head>
		<BaseHead
			title="vegetalope"
			description={SITE_DESCRIPTION}
			image={SITE_IMAGE}
			{locale}
			alternateUrls={{ en: '/', fr: '/fr/' }}
			enableLocaleDetection
		/>
	</head>
	<body>
		<Header title={SITE_TITLE} {locale} enHref="/" frHref="/fr/" />
		<main
			class="content stack site-index"
			transition:name="page-content"
			transition:animate={pageContentTransition}
		>
			<header class="stack">
				<h1 class="sr-only">{SITE_TITLE}</h1>
				<p>{strings.intro}</p>
			</header>

			<nav aria-label="Site navigation" class="stack nav-sections">
				<section class="stack nav-section" aria-labelledby="nav-write">
					<h2 id="nav-write">{strings.write}</h2>
					<ul class="card-list">
						{latestWriteArticles.map((article) => {
							const url = `/write/${getArticleParts(article.id).slug}`
							return (
								<li>
									<a
										href={url}
										class="transition-title-link"
										style={`--view-transition-name: ${viewTransitionNameFromPath(url)};`}
										transition:name={viewTransitionNameFromPath(url)}
									>
										{article.data.title}
									</a>
									<p>{article.data.description}</p>
								</li>
							)
						})}
					</ul>
					<p class="section-more"><a href="/write/">{strings.allArticles} →</a></p>
				</section>

				<section class="stack nav-section" aria-labelledby="nav-build">
					<h2 id="nav-build">{strings.build}</h2>
					<ul class="card-list">
						<li><a href="/build/dyss">dyss</a><p>{strings.buildDyss}</p></li>
						<li><a href="https://moments.vegetalope.com/">Moment Tracker</a><p>{strings.buildMoments}</p></li>
						<li><a href="/build/addons">{strings.firefoxAddons}</a><p>{strings.buildAddons}</p></li>
					</ul>
				</section>
			</nav>
		</main>
		<Footer {locale} />
	</body>
</html>

---
import DyssExample from '../../../../layouts/DyssExample.astro';
import LiveCodeSection from '../../../../components/dyss/LiveCodeSection.astro';

const title = 'dyss: AFR fuel map';
const description = 'An engine operating point, a target map, and the response in between.';
---

<DyssExample title={title} description={description} wide>
	<div class="fuel-map-demo" data-dyss-fuel-map>
		<div class="fuel-map-toolbar">
			<div>
				<p class="fm-eyebrow">Engine simulation / gasoline</p>
				<h2>Follow the fuel.</h2>
			</div>
			<span class="fm-status" data-dyss-status role="status">Ready / idle</span>
		</div>

		<div class="fuel-map-readouts" aria-label="Engine telemetry" aria-live="off">
			<div><span>Engine speed</span><strong data-fm-rpm>850</strong><small>RPM</small></div>
			<div><span>Engine load</span><strong data-fm-load>23</strong><small>%</small></div>
			<div><span>Target AFR</span><strong data-fm-target>—</strong><small>map lookup</small></div>
			<div class="fm-measured"><span>Measured AFR</span><strong data-fm-measured>—</strong><small>wideband model</small></div>
		</div>

		<div class="fm-map-heading">
			<h3>Target AFR map</h3>
			<span><i class="fm-point-key"></i> Operating point &amp; recent path</span>
		</div>
		<div class="fuel-map-table-wrap" tabindex="0" role="region" aria-label="Scrollable target AFR map">
			<div class="fm-map-stage" data-fm-stage>
				<table class="fuel-map-table" aria-label="Target air to fuel ratio by engine load and RPM">
					<thead data-dyss-head></thead>
					<tbody data-dyss-body></tbody>
				</table>
				<svg class="fm-map-overlay" data-fm-overlay aria-hidden="true">
					<path data-fm-trail fill="none" stroke="#243548" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					<g data-fm-marker>
						<circle r="10" fill="#20364b" fill-opacity="0.2" stroke="white" stroke-width="1.5" />
						<circle r="4" fill="white" stroke="#20364b" stroke-width="2" />
					</g>
				</svg>
			</div>
		</div>
		<div class="fm-map-footer">
			<p>Load increases ↓ <span>Engine speed increases →</span></p>
			<div class="fm-scale" aria-label="AFR color scale: rich 12, stoichiometric 14.7, lean 15.5">
				<div class="fm-scale-bar"></div>
				<div><span>12.0 / rich</span><span>14.7</span><span>15.5 / lean</span></div>
			</div>
		</div>

		<section class="fm-response" aria-label="AFR sensor response">
			<div class="fm-map-heading">
				<h3>Sensor response <small>/ last 8 seconds</small></h3>
				<div class="fm-trace-key"><span>– – Target</span><span>━━ Measured</span></div>
			</div>
			<svg class="fm-chart" viewBox="0 0 640 108" role="img" aria-label="AFR history: dashed target and solid measured sensor response">
				<g class="fm-chart-grid" fill="none"><path d="M32 10H632 M32 65.65H632 M32 94H632" /></g>
				<g class="fm-chart-labels"><text x="0" y="14">20+</text><text x="0" y="69.65">14.7</text><text x="0" y="98">12</text></g>
				<path class="fm-target-trace" data-fm-target-trace fill="none" />
				<path class="fm-measured-trace" data-fm-measured-trace fill="none" />
			</svg>
			<p data-fm-explanation>The map stays fixed. The four outlined cells blend into the target at the operating point.</p>
		</section>

		<div class="fuel-map-controls">
			<button type="button" class="fm-play" data-dyss-live aria-pressed="false">Start drive cycle</button>
			<button type="button" data-dyss-reseed>Reset cycle</button>
			<label class="fuel-map-interval"><span>CSS update</span>
				<select data-dyss-interval>
					<option value="10">10ms</option>
					<option value="50" selected>50ms</option>
					<option value="100">100ms</option>
					<option value="250">250ms</option>
					<option value="500">500ms</option>
				</select>
			</label>
			<span class="fuel-map-fps" data-dyss-fps>0 updates/s</span>
		</div>
		<p class="fm-cycle-note">32-second loop · idle → cruise → full load → gear change → lift-off</p>
		<details class="fm-code-details">
			<summary>Behind the cells / live dyss rules</summary>
			<LiveCodeSection className="fuel-map-code" />
		</details>
		<p class="fm-footnote">Illustrative simulation with sensor delay, transient enrichment, and overrun fuel cut.
			Behavior inspired by the <a href="https://wiki.speeduino.com/en/configuration/Acceleration_Wizard">Speeduino acceleration model</a>.
		</p>
	</div>
	<script src="../../../../scripts/dyss-fuel-map-demo.js"></script>
</DyssExample>

<style>
	.fuel-map-demo {
		--fm-panel: color-mix(in oklab, var(--color-bg) 96%, var(--color-ink));
		--fm-sensor: #a24d2c;
		padding: clamp(0.9rem, 3vw, 1.7rem);
		border: 1px solid var(--hairline);
		border-radius: 0.5rem;
		background: var(--fm-panel);
		min-width: 0;
	}
	:global(.theme-dark) .fuel-map-demo { --fm-sensor: #f3b089; }
	.fuel-map-toolbar, .fm-map-heading, .fm-map-footer, .fuel-map-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
	.fm-eyebrow, .fm-status, .fuel-map-readouts span, .fuel-map-readouts small, .fm-map-heading > span, .fm-map-footer, .fm-trace-key, .fuel-map-controls, .fm-cycle-note, .fm-code-details summary { font-family: var(--font-label); font-size: 0.66rem; }
	.fm-eyebrow { text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-ink-muted); margin: 0 0 0.4rem; }
	.fuel-map-toolbar h2 { font-size: 1.6rem; margin: 0; letter-spacing: -0.04em; }
	.fm-status { border: 1px solid var(--hairline); border-radius: 3rem; padding: 0.4rem 0.65rem; }
	.fm-status::before { content: ''; display: inline-block; width: 6px; height: 6px; background: var(--color-ink-muted); border-radius: 50%; margin-right: 0.5rem; }
	.fuel-map-demo[data-running] .fm-status::before { background: #4d9c85; box-shadow: 0 0 0 3px #4d9c851c; }
	.fuel-map-readouts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--hairline); margin-block: 1.5rem; }
	.fuel-map-readouts > div { padding: 1rem 0.6rem; border-right: 1px solid var(--hairline); }
	.fuel-map-readouts > div:first-child { padding-left: 0; }
	.fuel-map-readouts > div:last-child { border-right: 0; }
	.fuel-map-readouts span, .fuel-map-readouts small { display: block; color: var(--color-ink-muted); }
	.fuel-map-readouts strong { display: block; font-family: var(--font-label); font-weight: 500; font-size: clamp(1.35rem, 3vw, 2rem); font-variant-numeric: tabular-nums; margin-block: 0.3rem; letter-spacing: -0.07em; }
	.fm-measured strong { color: var(--fm-sensor); }
	.fm-map-heading { margin-bottom: 0.65rem; gap: 0.5rem; }
	.fm-map-heading h3 { font-size: 0.82rem; margin: 0; font-weight: 500; }
	.fm-map-heading h3 small { color: var(--color-ink-muted); font-weight: 400; font-size: 0.65rem; }
	.fm-point-key { display: inline-block; width: 7px; height: 7px; border: 1px solid var(--color-ink); border-radius: 50%; margin-right: 0.25rem; }
	.fuel-map-table-wrap { overflow-x: auto; border: 1px solid var(--hairline); border-radius: 3px; }
	.fm-map-stage { position: relative; min-width: 800px; }
	.fuel-map-table { width: 100%; border-collapse: collapse; table-layout: fixed; margin: 0; line-height: 1.4; }
	.fuel-map-table :global(th), .fuel-map-table :global(td) { border: 1px solid #25384b1f; padding: 0.62rem 0.15rem; text-align: center; font-family: var(--font-label); font-variant-numeric: tabular-nums; }
	.fuel-map-table :global(th) { font-size: 0.57rem; font-weight: 400; color: var(--color-ink-muted); background: var(--fm-panel); }
	.fuel-map-table :global(th:first-child) { width: 68px; position: sticky; left: 0; z-index: 1; }
	.fuel-map-table :global(td) { font-size: 0.66rem; font-weight: 500; }
	.fm-map-overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
	.fm-map-footer { margin-block: 0.75rem 1.3rem; align-items: flex-start; color: var(--color-ink-muted); }
	.fm-map-footer p { margin: 0; display: grid; gap: 0.3rem; font-size: 0.66rem; }
	.fm-scale { width: 240px; max-width: 100%; }
	.fm-scale-bar { height: 5px; background: linear-gradient(to right, rgb(72,157,175), rgb(119,185,172) 29%, rgb(230,218,158) 77%, rgb(216,151,111)); border-radius: 2px; }
	.fm-scale > div:last-child { display: flex; justify-content: space-between; font-size: 0.57rem; margin-top: 0.4rem; }
	.fm-response { padding: 1rem; border: 1px solid var(--hairline); border-radius: 3px; }
	.fm-trace-key { display: flex; gap: 1rem; color: var(--color-ink-muted); }
	.fm-trace-key span:last-child { color: var(--fm-sensor); }
	.fm-chart { display: block; width: 100%; height: auto; overflow: visible; }
	.fm-chart-grid { stroke: var(--hairline); stroke-width: 0.6; }
	.fm-chart-labels { fill: var(--color-ink-muted); font-size: 8px; font-family: var(--font-label); }
	.fm-target-trace { stroke: var(--color-ink-muted); stroke-width: 1.3; stroke-dasharray: 4 4; }
	.fm-measured-trace { stroke: var(--fm-sensor); stroke-width: 2; stroke-linejoin: round; }
	.fm-response p { font-size: 0.7rem; color: var(--color-ink-muted); line-height: 1.6; margin: 0.5rem 0 0; min-height: 2.3em; }
	.fuel-map-controls { justify-content: flex-start; margin-top: 1.2rem; gap: 0.6rem; }
	.fuel-map-controls button { padding: 0.6rem 0.8rem; font-size: 0.65rem; background: transparent; color: var(--color-ink); border: 1px solid var(--hairline); border-radius: 3px; cursor: pointer; letter-spacing: 0; text-transform: none; }
	.fuel-map-controls .fm-play { background: var(--color-ink); color: var(--color-bg); border-color: var(--color-ink); }
	.fuel-map-controls button:hover { filter: brightness(0.9); }
	.fuel-map-interval { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
	.fuel-map-interval select { font: inherit; padding: 0.4rem; border: 1px solid var(--hairline); border-radius: 3px; background: var(--color-bg); color: var(--color-ink); }
	.fuel-map-fps { color: var(--color-ink-muted); min-width: 6.5em; text-align: right; font-variant-numeric: tabular-nums; }
	.fm-cycle-note { color: var(--color-ink-muted); line-height: 1.7; margin-block: 0.8rem 1.3rem; }
	.fm-code-details { border-top: 1px solid var(--hairline); padding-top: 1rem; }
	.fm-code-details summary { cursor: pointer; }
	.fm-code-details :global(.fuel-map-code) { margin-top: 1rem; --dyss-code-max-height: 280px; }
	.fm-footnote { font-size: 0.64rem; color: var(--color-ink-muted); line-height: 1.7; margin: 1rem 0 0; }
	@media (max-width: 600px) {
		.fuel-map-readouts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.fuel-map-readouts > div:nth-child(2) { border-right: 0; }
		.fuel-map-readouts > div:nth-child(n + 3) { border-top: 1px solid var(--hairline); }
		.fuel-map-readouts > div:nth-child(3) { padding-left: 0; }
		.fuel-map-interval { margin-left: 0; }
		.fm-map-heading > span { font-size: 0.58rem; }
		.fm-response { padding: 0.65rem; }
	}
</style>

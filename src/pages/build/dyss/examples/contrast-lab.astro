---
import DyssExample from '../../../../layouts/DyssExample.astro'
import ColorPickerHex from '../../../../components/dyss/ColorPickerHex.astro'
import LiveCodeSection from '../../../../components/dyss/LiveCodeSection.astro'
const title = 'dyss: contrast lab'
const description =
	'Put adaptive text color to the test, with measured contrast beside every choice.'
---

<DyssExample title={title} description={description} wide>
	<div class="experiment-shell" data-dyss-contrast-lab>
		<div class="experiment-heading">
			<div>
				<p class="experiment-kicker">Adaptive color / measured against the background</p><h2>
					Make the choice visible.
				</h2>
			</div><span class="experiment-label" data-contrast-summary role="status"></span>
		</div>
		<div class="contrast-layout">
			<form class="experiment-controls contrast-controls" data-dyss-controls>
				<h3>Text selection</h3>
				<div class="experiment-actions" role="group" aria-label="Text selection method">
					<button
						type="button"
						class="experiment-button"
						data-contrast-mode="measured"
						aria-pressed="true">Best contrast</button
					><button
						type="button"
						class="experiment-button"
						data-contrast-mode="css"
						aria-pressed="false">CSS approximation</button
					>
				</div>
				<div class="contrast-candidates">
					<div>
						<span class="experiment-label">Light candidate</span><ColorPickerHex
							value="#ffffff"
							pickerAttrs={{ 'data-contrast-light': '', 'aria-label': 'Light text color' }}
							hexAttrs={{ 'data-contrast-light-hex': '', 'aria-label': 'Light text color hex' }}
						/>
					</div>
					<div>
						<span class="experiment-label">Dark candidate</span><ColorPickerHex
							value="#14161a"
							pickerAttrs={{ 'data-contrast-dark': '', 'aria-label': 'Dark text color' }}
							hexAttrs={{ 'data-contrast-dark-hex': '', 'aria-label': 'Dark text color hex' }}
						/>
					</div>
				</div>
				<label class="contrast-threshold"
					><span class="experiment-label"
						>CSS lightness cutoff <output data-contrast-cutoff-output>0.71</output></span
					><input
						type="range"
						min="0.55"
						max="0.85"
						step="0.01"
						value="0.71"
						data-contrast-cutoff
						disabled
					/><small class="experiment-label">Active in CSS approximation mode.</small></label
				>
				<h3>Backgrounds</h3><div data-dyss-rows></div>
				<button type="button" class="experiment-button" data-dyss-add>Add background</button>
				<p class="experiment-meta" data-dyss-support></p>
			</form>
			<section aria-label="Live contrast samples">
				<div class="contrast-grid" data-dyss-preview></div>
			</section>
		</div>
		<p class="experiment-meta">
			Ratios use opaque sRGB colors. Normal text needs 4.5:1; large text needs 3:1 under <a
				href="https://www.w3.org/WAI/WCAG21/Understanding/contrast-minimum"
				>WCAG AA contrast guidance</a
			>. A lightness cutoff alone does not guarantee either.
		</p>
		<details class="experiment-code">
			<summary>Behind the swatches / live dyss rules</summary><LiveCodeSection />
		</details>
	</div>
	<script src="../../../../scripts/dyss-contrast-lab.js"></script>
</DyssExample>
<style>
	.contrast-layout {
		display: grid;
		grid-template-columns: minmax(270px, 0.85fr) minmax(0, 1.15fr);
		gap: 1.8rem;
		align-items: start;
	}
	.contrast-controls h3 {
		font-size: 0.8rem;
		margin: 0 0 0.8rem;
	}
	.contrast-candidates {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-block: 1.2rem;
	}
	.contrast-candidates > div {
		display: grid;
		gap: 0.35rem;
	}
	.contrast-threshold {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.contrast-threshold > span {
		display: flex;
		justify-content: space-between;
	}
	.contrast-controls :global(.contrast-row) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 28px 80px 24px;
		align-items: center;
		gap: 0.4rem;
		border-top: 1px solid var(--hairline);
		padding-block: 0.6rem;
	}
	.contrast-controls :global(input[type='color']) {
		padding: 0;
		background: transparent;
		border: 0;
		width: 26px;
		height: 28px;
		cursor: pointer;
	}
	.contrast-controls :global(button[data-remove]) {
		padding: 0.1rem;
		border-color: transparent;
		font-size: 0.9rem;
	}
	.contrast-controls > button {
		margin-top: 0.7rem;
	}
	.contrast-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.7rem;
	}
	.contrast-grid :global(.contrast-card) {
		min-width: 0;
		border-radius: 3px;
		padding: 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}
	.contrast-grid :global(.contrast-card h4) {
		font-size: 0.65rem;
		font-family: var(--font-label);
		font-weight: 400;
		margin: 0;
		color: inherit;
		overflow-wrap: anywhere;
	}
	.contrast-grid :global(.contrast-sample) {
		font-size: 2.2rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.07em;
		color: inherit;
	}
	.contrast-grid :global(.contrast-card p) {
		font-size: 0.72rem;
		line-height: 1.5;
		margin: 0;
		color: inherit;
	}
	.contrast-grid :global(.contrast-ratio) {
		font: 1rem/1.4 var(--font-label);
		font-variant-numeric: tabular-nums;
		margin-top: auto;
		padding-top: 0.5rem;
	}
	.contrast-grid :global(.contrast-grade) {
		white-space: pre-line;
		font: 0.52rem/1.7 var(--font-label);
		padding-top: 0.45rem;
		border-top: 1px solid currentColor;
	}
	@media (max-width: 800px) {
		.contrast-layout {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 420px) {
		.contrast-grid :global(.contrast-card) {
			padding: 0.8rem;
		}
	}
</style>

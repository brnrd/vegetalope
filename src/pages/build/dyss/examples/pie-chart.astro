---
import DyssExample from '../../../../layouts/DyssExample.astro'
import LiveCodeSection from '../../../../components/dyss/LiveCodeSection.astro'
const title = 'dyss: revenue mix'
const description = 'One dataset, a live chart, and a clear view of every contribution.'
---

<DyssExample title={title} description={description} wide>
	<div class="experiment-shell" data-dyss-demo>
		<div class="experiment-heading">
			<div>
				<p class="experiment-kicker">Data visualization / conic gradients</p><h2>
					Every slice has a story.
				</h2>
			</div>
			<span class="experiment-label" data-pie-status role="status">30-second window / paused</span>
		</div>
		<div class="revenue-layout">
			<figure class="revenue-figure">
				<div class="revenue-donut">
					<ul class="revenue-pie" data-dyss-pie aria-label="Revenue share by category"></ul>
					<div class="revenue-total">
						<span>Last 30s revenue</span><strong data-pie-total>$1,000</strong><small data-pie-count
							>4 categories</small
						>
					</div>
				</div>
				<figcaption>
					A rolling view of recent sales.<br />Edit a value to redistribute the chart.
				</figcaption>
			</figure>
			<form class="experiment-controls revenue-controls" data-dyss-controls>
				<div class="revenue-column-labels">
					<span>Category / color</span><span>Revenue ($)</span><span>Share</span>
				</div>
				<div data-dyss-rows></div>
				<button type="button" class="experiment-button" data-dyss-add>Add category</button>
			</form>
		</div>
		<div class="revenue-stream">
			<span class="experiment-label">Latest sale</span>
			<strong data-pie-latest>Start sales to see the next transaction</strong>
		</div>
		<div class="experiment-actions revenue-actions">
			<button type="button" class="experiment-button primary" data-dyss-live aria-pressed="false"
				>Simulate sales</button
			>
			<button type="button" class="experiment-button" data-pie-reset>Reset sample</button>
			<label class="experiment-label revenue-refresh"
				>Refresh <select data-dyss-interval aria-label="Chart refresh interval"
					><option value="50">50ms</option><option value="250" selected>250ms</option><option
						value="1000">1s</option
					></select
				></label
			>
			<span class="experiment-label" data-dyss-fps>0 updates/s</span>
		</div>
		<p class="experiment-meta">
			Illustrative sales arrive about once a second and leave the window after 30 seconds. Smaller
			opening balances keep each transaction visible. Refresh controls when new data reaches the
			chart; the circle eases smoothly between updates.
		</p>
		<details class="experiment-code">
			<summary>Behind the chart / live dyss rules</summary><LiveCodeSection />
		</details>
	</div>
	<script src="../../../../scripts/dyss-pie-demo.js"></script>
</DyssExample>
<style>
	.revenue-layout {
		display: grid;
		grid-template-columns: minmax(250px, 0.85fr) minmax(0, 1.15fr);
		gap: 2rem;
		align-items: center;
	}
	.revenue-figure {
		margin: 0;
		display: grid;
		justify-items: center;
		gap: 1.5rem;
		padding-block: 1rem;
	}
	.revenue-donut {
		position: relative;
		width: min(100%, 290px);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--hairline);
	}
	.revenue-pie {
		list-style: none;
		margin: 0;
		padding: 0;
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: var(--hairline);
		overflow: hidden;
	}
	.revenue-pie :global(li) {
		position: absolute;
		margin: 0;
		padding: 0;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.revenue-total {
		position: absolute;
		inset: 23%;
		border-radius: 50%;
		background: var(--experiment-surface);
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
		pointer-events: none;
	}
	.revenue-total span,
	.revenue-total small,
	.revenue-figure figcaption {
		font: 0.64rem/1.7 var(--font-label);
		color: var(--color-ink-muted);
	}
	.revenue-total strong {
		font: 1.2rem/1.5 var(--font-label);
		letter-spacing: -0.05em;
		font-variant-numeric: tabular-nums;
	}
	.revenue-figure figcaption {
		text-align: center;
	}
	.revenue-column-labels {
		display: grid;
		grid-template-columns: 1fr 100px 55px 24px;
		font: 0.58rem var(--font-label);
		color: var(--color-ink-muted);
		gap: 0.5rem;
		padding-bottom: 0.7rem;
	}
	.revenue-controls :global(.revenue-row) {
		display: grid;
		grid-template-columns: 1fr 100px 55px 24px;
		gap: 0.5rem;
		align-items: center;
		padding: 0.8rem 0;
		border-top: 1px solid var(--hairline);
		transition: background-color 250ms ease;
	}
	.revenue-controls :global(.revenue-row[data-recent-sale]) {
		background: color-mix(in oklab, #4d9b91 12%, transparent);
	}
	.revenue-controls :global(.revenue-name) {
		display: flex;
		gap: 0.5rem;
		min-width: 0;
		align-items: center;
	}
	.revenue-controls :global(input[type='color']) {
		width: 19px;
		height: 25px;
		padding: 0;
		border: 0;
		background: transparent;
		flex-shrink: 0;
		cursor: pointer;
	}
	.revenue-controls :global(input[data-field='label']) {
		background: transparent !important;
		border-color: transparent !important;
		padding-inline: 0 !important;
	}
	.revenue-controls :global(output) {
		font: 0.7rem var(--font-label);
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.revenue-controls :global(button[data-remove]) {
		padding: 0.15rem;
		font-size: 0.9rem;
		border-color: transparent;
	}
	.revenue-controls > button {
		margin-top: 0.65rem;
	}
	.revenue-actions {
		border-top: 1px solid var(--hairline);
		padding-top: 1.2rem;
		margin-top: 0.8rem;
	}
	.revenue-stream {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.5rem 0.8rem;
		margin-top: 1.4rem;
	}
	.revenue-stream strong {
		font: 0.7rem/1.6 var(--font-label);
		font-variant-numeric: tabular-nums;
	}
	.revenue-refresh {
		margin-left: auto;
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	.revenue-refresh select {
		font: inherit;
		padding: 0.35rem;
		color: var(--color-ink);
		background: var(--color-bg);
		border: 1px solid var(--hairline);
	}
	@media (max-width: 800px) {
		.revenue-layout {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.revenue-donut {
			width: 250px;
		}
	}
	@media (max-width: 480px) {
		.revenue-controls :global(.revenue-row),
		.revenue-column-labels {
			grid-template-columns: minmax(0, 1fr) 80px 45px 20px;
			gap: 0.3rem;
		}
		.revenue-refresh {
			margin-left: 0;
		}
	}
</style>

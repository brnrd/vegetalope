---
import { Code } from 'astro:components'
import BaseHead from '../../../components/BaseHead.astro'
import Header from '../../../components/Header.astro'
import Footer from '../../../components/Footer.astro'
import {
	pageContentTransition,
	viewTransitionNameFromPath,
} from '../../../utils/viewTransitionName'

const pageTitle = 'dyss docs'
const pageDescription =
	'Create CSS rules from JavaScript, update them at runtime, and share them across elements.'
const titleTransitionName = viewTransitionNameFromPath(Astro.url.pathname)
const codeThemes = { light: 'github-light', dark: 'github-dark' } as const

const escapeInlineHtml = (value: string) =>
	value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
const withInlineCode = (value: string) =>
	escapeInlineHtml(value).replace(/`([^`]+)`/g, '<code>$1</code>')

const properties = [
	{
		id: 'property-mode',
		label: 'mode',
		kind: 'Property',
		signature: 'sheet.mode',
		summary: 'The stylesheet mode selected when the instance was created.',
		type: "'style-tag' | 'constructed' | null",
		parameters: [],
		notes: ['Defaults to `style-tag`. Becomes `null` after `destroy()`.'],
		example: `const sheet = new Sheet({ mode: 'constructed' })

console.log(sheet.mode) // 'constructed'`,
	},
	{
		id: 'property-sheet',
		label: 'sheet',
		kind: 'Property',
		signature: 'sheet.sheet',
		summary:
			'The native stylesheet managed by this instance. Use it to access the CSS Object Model (CSSOM) directly.',
		type: 'CSSStyleSheet | null',
		parameters: [],
		notes: ['The same object returned by `getSheet()`. Becomes `null` after `destroy()`.'],
		example: `console.log(sheet.sheet?.cssRules.length)`,
	},
]

const constructor = {
	id: 'new-sheet',
	label: 'new Sheet',
	kind: 'Constructor',
	signature: 'new Sheet(options?)',
	summary: 'Creates an empty stylesheet and attaches it to the current document.',
	type: 'Sheet',
	parameters: [
		{
			name: 'options',
			type: "{ mode?: 'style-tag' | 'constructed' }",
			description: "Optional configuration object. Defaults to `{ mode: 'style-tag' }`.",
		},
	],
	notes: [
		'In `style-tag` mode, inserts a `<style>` element into `document.head`.',
		'In `constructed` mode, creates a `CSSStyleSheet` and adds it to `document.adoptedStyleSheets`. Throws if these APIs are unavailable.',
		'Create the instance in the browser, after `document.head` is available.',
	],
	example: `import Sheet from 'dyss'

const sheet = new Sheet()

// Or use a constructable stylesheet:
const adopted = new Sheet({ mode: 'constructed' })`,
}

const methods = [
	{
		id: 'add',
		label: 'add',
		signature: 'sheet.add(selector, set, index?)',
		summary: 'Inserts a new CSS rule. Appends it to the stylesheet unless you provide an index.',
		parameters: [
			{
				name: 'selector',
				type: 'string',
				description: 'A CSS selector, such as `.card`, `#app`, or `button[disabled]`.',
			},
			{
				name: 'set',
				type: 'Record<string, string>',
				description:
					"CSS declarations with camelCase keys and string values, such as `{ backgroundColor: 'navy' }`.",
			},
			{
				name: 'index',
				type: 'number',
				description:
					'Optional zero-based insertion position among top-level rules. Defaults to the end of the stylesheet.',
			},
		],
		notes: [
			'Always inserts a new rule, even if the selector already exists. Use `updateSet()` to change an existing rule.',
		],
		example: `sheet.add('.card', {
	padding: '1rem',
	backgroundColor: '#111827',
	color: '#ffffff'
})

// Insert before all other top-level rules.
sheet.add('.card--first', { order: '0' }, 0)`,
	},
	{
		id: 'add-class',
		label: 'addClass',
		signature: 'sheet.addClass(set)',
		summary:
			'Creates a rule with a randomly generated class name. Returns the name without a leading dot.',
		type: 'string',
		parameters: [
			{
				name: 'set',
				type: 'Record<string, string>',
				description: 'CSS declarations for the generated class, using the same format as `add()`.',
			},
		],
		notes: [
			'Apply the returned name with `element.classList.add()`. Add a leading `.` when passing it to selector-based methods such as `updateSet()`.',
		],
		example: `const pillClass = sheet.addClass({
	padding: '0.4rem 0.7rem',
	borderRadius: '999px',
	backgroundColor: '#304e77',
	color: '#ffffff'
})

const button = document.querySelector('button')
button?.classList.add(pillClass)`,
	},
	{
		id: 'update-set',
		label: 'updateSet',
		signature: 'sheet.updateSet(selector, set)',
		summary:
			'Merges declarations into the first matching top-level rule. Preserves properties you leave out.',
		parameters: [
			{
				name: 'selector',
				type: 'string',
				description: 'The exact selector of the top-level rule to update.',
			},
			{
				name: 'set',
				type: 'Record<string, string>',
				description:
					'Declarations to add or overwrite. Include `!important` at the end of a value to set its priority.',
			},
		],
		notes: [
			'If no top-level rule matches, creates one. Does not update rules nested inside `@media` blocks.',
		],
		example: `sheet.updateSet('.card', {
	backgroundColor: '#2563eb',
	borderRadius: '1rem',
	color: '#ffffff !important'
})
// Existing padding is preserved.`,
	},
	{
		id: 'replace-set',
		label: 'replaceSet',
		signature: 'sheet.replaceSet(selector, set)',
		summary: 'Replaces every declaration in the first matching top-level rule with the new set.',
		parameters: [
			{
				name: 'selector',
				type: 'string',
				description: 'The exact selector of the top-level rule to replace.',
			},
			{
				name: 'set',
				type: 'Record<string, string>',
				description:
					'The complete replacement declarations. Supports values ending in `!important`.',
			},
		],
		notes: [
			'If no top-level rule matches, creates one. Does not replace rules nested inside `@media` blocks.',
		],
		example: `sheet.replaceSet('.card', {
	display: 'grid',
	gap: '0.75rem'
})
// Previous padding, colors, and other declarations are removed.`,
	},
	{
		id: 'add-media',
		label: 'addMedia',
		signature: 'sheet.addMedia(mediaQuery, selector, set)',
		summary: 'Inserts a rule inside an `@media` block. Creates the block if it does not exist.',
		parameters: [
			{
				name: 'mediaQuery',
				type: 'string',
				description: 'The media query without `@media`, such as `(max-width: 48rem)` or `print`.',
			},
			{
				name: 'selector',
				type: 'string',
				description: 'The CSS selector to insert inside the block.',
			},
			{
				name: 'set',
				type: 'Record<string, string>',
				description: 'CSS declarations for the nested rule.',
			},
		],
		notes: [
			'Reuses a media block when its `mediaText` matches the query string. Each call appends a new selector rule inside it.',
		],
		example: `sheet.addMedia('(max-width: 48rem)', '.card', {
	padding: '0.75rem',
	fontSize: '0.95rem'
})`,
	},
	{
		id: 'add-pseudo',
		label: 'addPseudo',
		signature: 'sheet.addPseudo(selector, pseudo, set)',
		summary: 'Appends a pseudo-class or pseudo-element to a selector and inserts a new rule.',
		parameters: [
			{ name: 'selector', type: 'string', description: 'The base selector, such as `.button`.' },
			{
				name: 'pseudo',
				type: 'string',
				description:
					'A pseudo-class with or without its colon (`hover` or `:hover`). Include both colons for a pseudo-element, such as `::before`.',
			},
			{
				name: 'set',
				type: 'Record<string, string>',
				description: 'CSS declarations for the combined selector.',
			},
		],
		notes: [],
		example: `sheet.addPseudo('.button', ':hover', {
	backgroundColor: '#1a2747',
	color: '#ffffff'
})

sheet.addPseudo('.button', '::before', {
	content: '""',
	display: 'block'
})`,
	},
	{
		id: 'add-media-attribute',
		label: 'addMediaAttribute',
		signature: 'sheet.addMediaAttribute(mediaAttribute)',
		summary:
			'Sets the `media` attribute on the `<style>` element, so the entire stylesheet applies only when the query matches.',
		parameters: [
			{
				name: 'mediaAttribute',
				type: 'string',
				description: 'The attribute value, such as `print` or `(max-width: 60rem)`.',
			},
		],
		notes: [
			'Available only in `style-tag` mode. Throws in `constructed` mode. Use `addMedia()` to limit individual rules instead.',
		],
		example: `const printSheet = new Sheet()

printSheet.addMediaAttribute('print')
printSheet.add('.navigation', { display: 'none' })`,
	},
	{
		id: 'get',
		label: 'get',
		signature: 'sheet.get(selector)',
		summary: 'Returns the first matching CSS rule, or `null` if no rule matches.',
		type: 'CSSStyleRule | null',
		parameters: [
			{
				name: 'selector',
				type: 'string',
				description:
					'The exact selector to look up. Searches top-level rules and one level inside grouping rules, including `@media` blocks.',
			},
		],
		notes: [
			'Matches the browser’s `selectorText` exactly. Use the returned rule’s `style` or `cssText` to inspect its declarations.',
		],
		example: `const rule = sheet.get('.card')

if (rule) {
	console.log(rule.style.backgroundColor)
}`,
	},
	{
		id: 'get-sheet',
		label: 'getSheet',
		signature: 'sheet.getSheet()',
		summary: 'Returns the native stylesheet managed by this instance.',
		type: 'CSSStyleSheet | null',
		parameters: [],
		notes: ['Equivalent to reading `sheet.sheet`. Returns `null` after `destroy()`.'],
		example: `const nativeSheet = sheet.getSheet()

if (nativeSheet) {
	console.log(nativeSheet.cssRules.length)
}`,
	},
	{
		id: 'remove',
		label: 'remove',
		signature: 'sheet.remove(selector)',
		summary: 'Deletes the first matching rule. Does nothing if no rule matches.',
		parameters: [
			{
				name: 'selector',
				type: 'string',
				description:
					'The exact selector to remove. Searches top-level rules and one level inside grouping rules, including `@media` blocks.',
			},
		],
		notes: [
			'Uses the same selector matching as `get()`. Removes the CSS rule; leaves matching HTML elements in place.',
		],
		example: `sheet.remove('.card')`,
	},
	{
		id: 'remove-class',
		label: 'removeClass',
		signature: 'sheet.removeClass(className)',
		summary: 'Removes a class rule. Accepts a class name with or without a leading dot.',
		parameters: [
			{
				name: 'className',
				type: 'string',
				description: 'The class name, such as `badge` or `.badge`. Both target the `.badge` rule.',
			},
		],
		notes: ['Uses `remove()` internally. Does not remove the class name from HTML elements.'],
		example: `const badgeClass = sheet.addClass({ color: '#ffffff' })

sheet.removeClass(badgeClass)
sheet.removeClass('.legacy-badge')`,
	},
	{
		id: 'destroy',
		label: 'destroy',
		signature: 'sheet.destroy()',
		summary:
			'Detaches the stylesheet from the document and clears the instance references. Call it when a component unmounts or its styles are no longer needed.',
		parameters: [],
		notes: [
			'Removes the `<style>` element in `style-tag` mode, or removes the stylesheet from `document.adoptedStyleSheets` in `constructed` mode.',
			'Sets `sheet.mode` and `sheet.sheet` to `null`. Create a new instance if you need to add styles again.',
		],
		example: `sheet.destroy()`,
	},
].map(entry => ({ ...entry, kind: 'Method' }))

const entries = [constructor, ...properties, ...methods]
const navigation = [
	{
		title: 'Getting started',
		links: [
			{ id: 'docs-start', label: 'Quick start' },
			{ id: 'stylesheet-modes', label: 'Stylesheet modes' },
			{ id: 'declarations', label: 'Writing declarations' },
			{ id: 'public-api', label: 'API at a glance' },
		],
	},
	{ title: 'Create a sheet', links: [constructor] },
	{ title: 'Properties', links: properties },
	{ title: 'Methods', links: methods },
]
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main
			id="main-content"
			tabindex="-1"
			class="content content--wide docs-main"
			transition:name="page-content"
			transition:animate={pageContentTransition}
		>
			<article class="dyss-docs">
				<header class="docs-header">
					<p class="meta"><a href="/build/dyss">dyss</a> / Documentation</p>
					<h1
						class="transition-title"
						style={`--view-transition-name: ${titleTransitionName};`}
						transition:name={titleTransitionName}
					>
						{pageTitle}
					</h1>
					<p class="lede">{pageDescription}</p>
					<div class="docs-links">
						<a href="#docs-start">Quick start <span aria-hidden="true">↓</span></a>
						<a href="https://github.com/brnrd/dyss"
							>Source on GitHub <span aria-hidden="true">↗</span></a
						>
						<a href="/build/dyss">Live examples <span aria-hidden="true">↗</span></a>
					</div>
				</header>

				<div class="docs-layout">
					<details class="docs-mobile-nav">
						<summary>On this page</summary>
						<nav aria-label="Mobile documentation sections">
							{
								navigation.map(group => (
									<div class="nav-group">
										<p class="nav-label">{group.title}</p>
										<ul>
											{group.links.map(link => (
												<li>
													<a href={`#${link.id}`}>{link.label}</a>
												</li>
											))}
										</ul>
									</div>
								))
							}
						</nav>
					</details>
					<aside class="docs-sidebar">
						<nav aria-label="Documentation sections">
							{
								navigation.map(group => (
									<div class="nav-group">
										<p class="nav-label">{group.title}</p>
										<ul>
											{group.links.map(link => (
												<li>
													<a href={`#${link.id}`}>{link.label}</a>
												</li>
											))}
										</ul>
									</div>
								))
							}
						</nav>
					</aside>

					<div class="docs-body">
						<section class="docs-section" aria-labelledby="docs-start">
							<p class="section-label">Getting started</p>
							<h2 id="docs-start">Quick start</h2>
							<p>
								dyss is a small wrapper around the browser’s CSS Object Model (CSSOM). It creates a
								stylesheet and edits real CSS rules, so styles apply to every matching element
								through the normal CSS cascade.
							</p>
							<div class="code-example">
								<p class="code-label">Terminal</p>
								<Code
									code="npm install dyss"
									lang="sh"
									themes={codeThemes}
									tabindex="0"
									aria-label="Install dyss"
								/>
							</div>
							<p>Import the package into your browser code, create a sheet, and add a rule:</p>
							<div class="code-example">
								<p class="code-label">JavaScript</p>
								<Code
									code={`import Sheet from 'dyss'

const sheet = new Sheet()

sheet.add('.card', {
	padding: '1rem',
	backgroundColor: '#111827',
	color: '#ffffff'
})

// Update every element with class="card".
sheet.updateSet('.card', { backgroundColor: '#304e77' })`}
									lang="js"
									themes={codeThemes}
									tabindex="0"
									aria-label="Create and update a stylesheet"
								/>
							</div>
							<p>
								Call <a href="#destroy"><code>sheet.destroy()</code></a> during teardown to remove the
								stylesheet.
							</p>
							<p class="docs-callout">
								<strong>Browser only.</strong> Create the sheet in client-side code. In a server-rendered
								app, wait until the component mounts. The examples below assume <code>Sheet</code> is
								imported and <code>sheet</code> is an active instance.
							</p>
						</section>

						<section class="docs-section" aria-labelledby="stylesheet-modes">
							<h2 id="stylesheet-modes">Stylesheet modes</h2>
							<p>
								Both modes expose the same rule API. Choose how the stylesheet is attached to the
								document.
							</p>
							<div class="mode-grid">
								<div class="mode-option">
									<h3><code>style-tag</code> <span class="default-label">Default</span></h3>
									<p>
										Inserts a <code>&lt;style&gt;</code> element into <code>document.head</code>.
										Supports <a href="#add-media-attribute">a media attribute</a> for the whole sheet.
									</p>
								</div>
								<div class="mode-option">
									<h3><code>constructed</code></h3>
									<p>
										Creates a <code>CSSStyleSheet</code> and adds it to <code
											>document.adoptedStyleSheets</code
										>. Requires browser support for both APIs.
									</p>
								</div>
							</div>
						</section>

						<section class="docs-section" aria-labelledby="declarations">
							<h2 id="declarations">Writing declarations</h2>
							<p>
								Pass a plain object with camelCase property names, such as <code
									>backgroundColor</code
								> or <code>borderRadius</code>. Use strings for values, including units where CSS
								requires them: <code>'16px'</code>, <code>'1rem'</code>, or <code>'0'</code>.
							</p>
							<p>
								Use <a href="#add"><code>add()</code></a> for a new rule, <a href="#update-set"
									><code>updateSet()</code></a
								> to change selected properties, and <a href="#replace-set"
									><code>replaceSet()</code></a
								> to replace all declarations.
							</p>
						</section>

						<section class="docs-section" aria-labelledby="public-api">
							<p class="section-label">Reference</p>
							<h2 id="public-api">API at a glance</h2>
							<p>
								One constructor, {properties.length} instance properties, and {methods.length} methods.
								Select a name to jump to its parameters and example.
							</p>
							<div
								class="table-wrap api-index-wrap"
								role="region"
								aria-label="API quick reference; scroll horizontally on small screens"
								tabindex="0"
							>
								<table class="api-index">
									<caption class="sr-only">dyss public API</caption>
									<thead
										><tr
											><th scope="col">Kind</th><th scope="col">Name</th><th scope="col"
												>Signature</th
											></tr
										></thead
									>
									<tbody
										>{
											entries.map(entry => (
												<tr>
													<td class="api-kind">{entry.kind}</td>
													<th scope="row">
														<a href={`#${entry.id}`}>
															<code>{entry.label}</code>
														</a>
													</th>
													<td>
														<code>{entry.signature}</code>
													</td>
												</tr>
											))
										}</tbody
									>
								</table>
							</div>
							<p class="reference-note">
								Unless a return type is shown, methods return <code>undefined</code>. Methods are
								called on a <code>Sheet</code> instance.
							</p>
						</section>

						{
							entries.map(entry => (
								<section class="api-entry" id={entry.id} aria-labelledby={`${entry.id}-title`}>
									<header class="api-heading">
										<p class="section-label">{entry.kind}</p>
										<h3 id={`${entry.id}-title`}>
											<a href={`#${entry.id}`}>
												<>
													<code>{entry.label}</code>
													<span class="anchor-mark" aria-hidden="true">
														#
													</span>
												</>
											</a>
										</h3>
										<code class="signature">{entry.signature}</code>
									</header>
									<p set:html={withInlineCode(entry.summary)} />
									{entry.parameters.length > 0 && (
										<div class="api-params">
											<h4>Parameters</h4>
											<dl>
												{entry.parameters.map(parameter => (
													<div class="api-param">
														<dt>
															<code>{parameter.name}</code>
															<code class="param-type">{parameter.type}</code>
														</dt>
														<dd set:html={withInlineCode(parameter.description)} />
													</div>
												))}
											</dl>
										</div>
									)}
									{'type' in entry && entry.type && (
										<p class="api-return">
											<strong>{entry.kind === 'Property' ? 'Type' : 'Returns'}</strong>
											<code>{entry.type}</code>
										</p>
									)}
									{entry.notes.length > 0 && (
										<ul class="api-notes">
											{entry.notes.map(note => (
												<li set:html={withInlineCode(note)} />
											))}
										</ul>
									)}
									<div class="code-example">
										<p class="code-label">Example</p>
										<Code
											code={entry.example}
											lang="js"
											themes={codeThemes}
											tabindex="0"
											aria-label={`${entry.label} example`}
										/>
									</div>
								</section>
							))
						}

						<footer class="docs-next">
							<h2>See it in practice</h2>
							<p>
								Explore interactive examples of themes, annotations, charts, and motion built with
								dyss.
							</p>
							<a href="/build/dyss">Explore the examples <span aria-hidden="true">→</span></a>
							<a href="#docs-start">Back to quick start <span aria-hidden="true">↑</span></a>
						</footer>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.docs-main {
		max-width: 1180px;
	}

	.dyss-docs {
		max-width: none;
		--docs-space: clamp(2.75rem, 5vw, 4rem);
	}

	.dyss-docs :is(p, li, dd) {
		font-size: 0.95rem;
		line-height: 1.75;
		hyphens: none;
	}

	.dyss-docs :is(h2, h3, h4, p, ul, dl, pre) {
		margin: 0;
	}

	.dyss-docs :is(section, code) {
		overflow-wrap: normal;
	}

	.dyss-docs h2 {
		font-size: clamp(1.5rem, 2.4vw, 1.9rem);
		letter-spacing: -0.035em;
		line-height: 1.25;
	}

	.docs-header {
		padding-block: 0.5rem 2.5rem;
		border-bottom: 1px solid var(--hairline);
	}

	.docs-header h1 {
		margin-block: 1rem;
	}

	.dyss-docs .lede {
		max-width: 52ch;
		font-size: clamp(1.1rem, 1.8vw, 1.3rem);
		line-height: 1.65;
	}

	.docs-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.75rem;
		margin-top: 1.5rem;
		font-size: 0.85rem;
	}

	.docs-links a {
		text-underline-offset: 0.25em;
	}

	.docs-layout {

---
import { getCollection, render } from 'astro:content'
import Article from '../../../layouts/Article.astro'
import { getArticleParts } from '../../../i18n'

export async function getStaticPaths() {
	const entries = await getCollection('write')
	const englishSlugs = new Set(
		entries
			.map((entry) => getArticleParts(entry.id))
			.filter(({ locale }) => locale === 'en')
			.map(({ slug }) => slug),
	)

	return entries
		.filter((entry) => getArticleParts(entry.id).locale === 'fr')
		.map((entry) => {
			const { slug } = getArticleParts(entry.id)
			return {
				params: { slug },
				props: {
					entry,
					enHref: englishSlugs.has(slug) ? `/write/${slug}` : '/',
				},
			}
		})
}

const { entry, enHref } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(entry)
const slug = getArticleParts(entry.id).slug
const frHref = `/fr/write/${slug}`
const frontmatter = { ...entry.data, ...remarkPluginFrontmatter }
const alternateUrls = enHref === '/' ? { fr: frHref } : { en: enHref, fr: frHref }
---

<Article {frontmatter} locale="fr" {alternateUrls} {enHref} {frHref}>
	<Content />
</Article>
